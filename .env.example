# Copy to .env.local for local dev; set the same names on the Vercel project.
# All server-side — none are exposed to the browser.

# Live Google rating + reviews (Places API (New)). Without it the site shows
# no rating at all (never a typed number) and review links fall back to a
# Maps search.
PLACES_API_KEY=
# Optional: skips the text search when the Business Profile's place id is known.
GOOGLE_PLACE_ID=

# GoHighLevel — contact form → sub-account contact + note + tag.
# Private Integration token (Settings → Private Integrations, scope contacts.write)
GHL_API_KEY=
GHL_LOCATION_ID=
# Tag the acknowledgement / after-hours workflows trigger on (default below).
GHL_CONTACT_TAG=website-enquiry
